# ==== 「我的小窝」后端环境配置 ====
# 复制本文件为 .env，填入你自己的数据库账号密码与随机密钥

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写数据库密码
DB_NAME=little_home

# 鉴权：用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=请替换为随机长字符串
TOKEN_EXPIRE_HOURS=72

# 服务（0.0.0.0 = 局域网内其他设备也能访问；仅本机用可改 127.0.0.1）
HOST=0.0.0.0
PORT=8000

# 跨域白名单：逗号分隔；前后端分离时填前端域名
CORS_ORIGINS=*
